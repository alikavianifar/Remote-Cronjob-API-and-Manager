# Copy to .env and adjust. The backend reads real environment variables;
# to load a file, start it with:  node --env-file=.env server.js

# development | production
NODE_ENV=development

# Where the API listens. 127.0.0.1 keeps it private to this machine;
# use 0.0.0.0 only behind a firewall or a reverse proxy.
HOST=127.0.0.1
PORT=3000

# Set to true when running behind a reverse proxy, so rate limiting sees the real client IP.
TRUST_PROXY=false

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# REQUIRED in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a random secret is generated on every start.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Administrator account. ADMIN_PASSWORD is REQUIRED in production (min. 12 characters).
# When unset in development, the password is "admin123".
# Changing ADMIN_PASSWORD and restarting updates the stored password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JSON data file with users, jobs and logs (default: src/backend/data/db.json).
# DATA_FILE=/var/lib/cronjob-manager/db.json

# Path of the crontab binary.
# CRONTAB_BIN=crontab

# true = do not touch the real crontab and do not execute commands (default on Windows).
# CRONMGR_MOCK=false

# Force Run limits.
COMMAND_TIMEOUT_MS=60000
MAX_OUTPUT_BYTES=65536
LOG_RETENTION_PER_JOB=200

# Rate limits (requests per window, per client IP).
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10
API_RATE_WINDOW_MS=900000
API_RATE_MAX=600

# debug | info | warn | error | silent
LOG_LEVEL=info
